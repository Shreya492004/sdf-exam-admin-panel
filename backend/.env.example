# Server
PORT=3000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# PostgreSQL (matches docker-compose.yml). DATABASE_URL, if set, is used instead of the DB_* values.
DB_HOST=localhost
DB_PORT=5432
DB_USER=school
DB_PASSWORD=school
DB_NAME=student_management
# DATABASE_URL=postgres://school:school@localhost:5432/student_management
# DB_SSL=true

# Admin login for the panel — change these.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
JWT_SECRET=change-this-to-a-long-random-string
ADMIN_TOKEN_TTL=12h
# Token lifetime when "Remember me" is ticked on the login page
ADMIN_REMEMBER_TTL=30d

# Load demo students/subjects/exams into an empty database on first start.
SEED_DEMO_DATA=true

# pgAdmin (docker compose) — web UI on http://localhost:8000
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
