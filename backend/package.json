{
  "name": "student-management-backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS API for the Student Management admin panel",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "bun run build && bun dist/main.js",
    "dev": "bun --watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/typeorm": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
